<div class='card'>
  <div class='card-header'>
    <h5>Declaratie wijzigen</h5>
  </div>
  <div class='card-body'>
    <Declarations::Form
      @model={{this.model}}
      @onSubmit={{this.submit}}
      @errorMessage={{this.errorMessage}}
    >
      <LinkTo
        @route='declarations.declaration'
        @model={{this.model.id}}
        class='btn btn-default'
      >
        Annuleren
      </LinkTo>
    </Declarations::Form>
  </div>
</div>
