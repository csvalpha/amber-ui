<div class='card'>
  <div class='card-header'>
    <h5>Declaratie verwijderen</h5>
  </div>
  <div class='card-block p-3'>
    <p class='card-text'>
      Weet je zeker dat je de declaratie "{{this.model.description}}" wilt
      verwijderen?
    </p>
    {{#unless (eq this.model.user.id this.session.currentUser.id)}}
      <p class='card-text text-muted'>
        Het lid krijgt een mail dat de declaratie is verwijderd. Wil je liever
        een reden geven? Keur de declaratie dan af.
      </p>
    {{/unless}}
    {{#if this.errorMessage}}
      <div class='text-danger'>{{this.errorMessage}}</div>
    {{/if}}
  </div>
  <div class='card-footer'>
    <button {{on 'click' this.destroyModel}} class='btn btn-danger' type='button'>
      Verwijderen
    </button>
    <LinkTo
      @route='declarations.declaration'
      @model={{this.model.id}}
      class='btn btn-default'
    >
      Annuleren
    </LinkTo>
  </div>
</div>
