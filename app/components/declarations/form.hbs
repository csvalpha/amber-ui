<form {{on 'submit' (prevent-default @onSubmit)}}>
  <ModelForm::TextInput
    @model={{@model}}
    @property='description'
    @label='Waarvoor is het?'
    @placeholder='Bijv. boodschappen voor de borrel'
    @required={{true}}
  />
  <ModelForm::TextInput
    @model={{@model}}
    @property='amount'
    @type='number'
    @step='0.01'
    @label='Bedrag in euro'
    @required={{true}}
  />
  <ModelForm::DateInput
    @model={{@model}}
    @property='purchaseDate'
    @label='Datum van aankoop'
    @required={{true}}
  />

  <div class='form-check my-3'>
    <input
      id='declaration-receipt-missing'
      class='form-check-input'
      type='checkbox'
      checked={{this.receiptMissing}}
      {{on 'change' this.toggleReceiptMissing}}
    />
    <label class='form-check-label' for='declaration-receipt-missing'>
      Ik heb geen bon
    </label>
  </div>

  {{#if this.receiptMissing}}
    <div class='alert alert-warning'>
      <FaIcon @icon='triangle-exclamation' />
      Let op: zonder bon ben je zelf persoonlijk verantwoordelijk voor de juistheid van deze declaratie.
    </div>
    <ModelForm::TextareaInput
      @model={{@model}}
      @property='missingReceiptReason'
      @label='Waarom ontbreekt de bon?'
      @required={{true}}
      @maxlength={{1000}}
    />
  {{else}}
    <ModelForm::FileInput
      @model={{@model}}
      @property='receiptPreview'
      @label='Bon (foto of PDF)'
      @loadedCallback={{this.receiptLoaded}}
      @validExtensions={{this.validExtensions}}
      @validMimetypes={{this.validMimetypes}}
    />
    {{#if this.receiptFileName}}
      <p class='text-muted'><FaIcon @icon='file' /> {{this.receiptFileName}}</p>
    {{else if @model.hasReceipt}}
      <p class='text-muted'>Er is al een bon geüpload. Kies een nieuw bestand om het te vervangen.</p>
    {{/if}}
    {{form-control-feedback @model.errors.receipt}}
  {{/if}}

  <ModelForm::FormActions @model={{@model}} @errorMessage={{@errorMessage}}>
    {{yield}}
  </ModelForm::FormActions>
</form>
